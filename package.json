{
  "name": "@yedoma-labs/ichchi-state",
  "version": "0.1.0",
  "description": "Lightweight, TypeScript-first state manager with DevTools and time-travel",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "require": "./dist/middleware.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest src",
    "test:run": "vitest run src",
    "test:ui": "vitest --ui src",
    "test:coverage": "vitest run --coverage src",
    "bench": "vitest bench src",
    "bench:run": "vitest bench --run src",
    "demo": "pnpm run build && pnpm exec serve . -l 5173",
    "demo:dev": "pnpm exec serve . -l 5173",
    "e2e": "pnpm exec playwright test",
    "test:e2e": "pnpm exec playwright test",
    "e2e:ui": "pnpm exec playwright test --ui",
    "e2e:serve": "pnpm exec serve examples/e2e -l 5173",
    "e2e:install": "pnpm exec playwright install chromium",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run typecheck && pnpm run test:run && pnpm run build"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm run typecheck && pnpm run test:run && pnpm run build",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "keywords": [
    "state",
    "state-management",
    "store",
    "typescript",
    "react",
    "devtools",
    "lightweight"
  ],
  "author": "yedoma-labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yedoma-labs/ichchi-state"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.61.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^5.0.3",
    "happy-dom": "^20.10.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "semantic-release": "^25.0.9",
    "serve": "^14.2.6",
    "simple-git-hooks": "^2.13.1",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
